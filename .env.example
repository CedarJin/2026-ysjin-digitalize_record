# Do not commit actual credentials. Set the key only on the extraction machine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Default endpoint; use the regional endpoint required by your OpenAI project.
# OPENAI_BASE_URL=https://api.openai.com/v1
# US regional projects: OPENAI_BASE_URL=https://us.api.openai.com/v1
# Optional PostgreSQL persistence; otherwise P0/P1 uses a local SQLite workspace.
# FOOD_RECORD_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/food_records
